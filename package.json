{
  "name": "career-genie",
  "version": "0.0.3",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:security": "tsx scripts/security-check.ts",
    "check:csp": "tsx scripts/csp-check.ts",
    "eval:grounding": "tsx scripts/grounding-check.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e && npm run check:security && npm run check:csp",
    "package:release": "node scripts/assemble-release.mjs",
    "package:desktop": "node scripts/prepare-desktop-icon.mjs && electron-builder --config electron-builder.yml --publish never",
    "desktop:dev": "npm run build && npm run package:release && electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@react-pdf/renderer": "^4.5.1",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
